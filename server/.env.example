# ScamShield AI Server Configuration
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Google Gemini API Key (Required for live LLM reasoning; deterministic heuristic engine is used if omitted)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Model selection (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=45

# Optional Threat Intelligence Feed API Key
THREAT_INTEL_API_KEY=
