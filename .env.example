# ScamShield AI Server & Client Configuration

# Server Port
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Google Gemini API Key
# Optional: If omitted or invalid, ScamShield automatically and transparently operates
# using its verified deterministic heuristic engine with full English & Telugu rule support.
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini Model
GEMINI_MODEL=gemini-1.5-flash

# Rate Limiting (express-rate-limit)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=45

# Optional Threat Intelligence Feed API Key
THREAT_INTEL_API_KEY=
